# Local development profile template. Copy to config/.env.dev and set ENV_MODE=dev.

# Local listener and hot reload.
SERVER__HOST=127.0.0.1
SERVER__PORT=8765
SERVER__RELOAD=true

# Local PostgreSQL connection.
DATABASE__BACKEND=postgresql
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=agent_task_platform_dev
DATABASE__USER=postgres
DATABASE__PASSWORD=CHANGE_ME

# Generate a local key before use, for example: openssl rand -hex 32
AUTH__API_KEYS=[{"key":"REPLACE_WITH_LOCAL_KEY","name":"local","scopes":["*"]}]

KANBAN__REQUIRE_API_KEY=true

# Generate a local callback signing secret before use.
CALLBACK__SIGNING_SECRET=REPLACE_WITH_LOCAL_CALLBACK_SECRET

# The built-in examples do not require a model key.
MODEL__API_KEY=CHANGE_ME
