# Environment profile template.
#
# Usage:
#   cp config/.env.profile.example config/.env.production
#   ENV_MODE=production agent-task-platform serve
#
# Load order: config/.env, config/.env.{ENV_MODE}, then process environment.
# The selected profile overrides the base file. Real profiles remain ignored.
#
APP__NAME=agent-task-platform

# ---- Server ----
SERVER__HOST=0.0.0.0
SERVER__PORT=8765

# ---- Database ----
DATABASE__HOST=__FILL_ME__
DATABASE__PORT=5432
DATABASE__NAME=agent_task_platform
DATABASE__USER=agent_task_platform
DATABASE__PASSWORD=__FILL_ME__

# ---- Authentication ----
AUTH__API_KEYS=[{"key":"REPLACE_WITH_DEPLOYMENT_KEY","name":"deployment-client","scopes":["runs"]}]

KANBAN__REQUIRE_API_KEY=true

# ---- Callback ----
CALLBACK__SIGNING_SECRET=__FILL_ME__
CALLBACK__URL_ALLOWLIST=["__FILL_ME__"]

# ---- Model provider (optional for tool-only agents) ----
MODEL__BASE_URL=__FILL_ME__
MODEL__API_KEY=__FILL_ME__
MODEL__MODEL=__FILL_ME__
